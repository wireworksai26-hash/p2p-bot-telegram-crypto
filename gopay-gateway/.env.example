PORT=3005
# Wajib acak, min 24 karakter, sama dengan GOPAY_API_KEY di bot. Gateway menolak start bila lemah.
API_KEY=
# Default 127.0.0.1. Isi 0.0.0.0 hanya bila diakses dari host lain (pasang firewall).
GOPAY_BIND_HOST=127.0.0.1
QRIS_STATIC=YOUR_QRIS_STATIC_HERE
GOPAY_MERCHANT_ID=YOUR_MERCHANT_ID_HERE # Opsional: Kosongkan jika tidak tahu (akan menggunakan default fallback)
