# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_IDS=123456789,987654321
# Optional: dedicated sell dashboard/notifications group. Individual admins still
# must be in ADMIN_CHAT_IDS to approve a verified order. Leave empty for fallback.
SELL_ADMIN_CHAT_ID=

# Server & Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crypto_p2p_bot
PORT=8000

# GoPay / Gopiz Gateway (lokal)
GOPAY_GATEWAY_URL=http://127.0.0.1:3005
GOPAY_API_KEY=RAHASIA

# EVM Wallets (BSC, ETH, AVAX, MATIC, BASE, ARB, Gravity)
EVM_PRIVATE_KEY=your_evm_private_key_here
EVM_WALLET_ADDRESS=your_evm_public_address_here

# RPC Endpoints
BSC_RPC=https://bsc-dataseed.binance.org/
ETH_RPC=https://cloudflare-eth.com
AVAX_RPC=https://api.avax.network/ext/bc/C/rpc
POLYGON_RPC=https://polygon-rpc.com
BASE_RPC=https://mainnet.base.org
ARB_RPC=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC=https://mainnet.optimism.io
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
KAIA_RPC=https://public-en.node.kaia.io
BERA_RPC=https://rpc.berachain.com
HYPEREVM_RPC=https://rpc.hyperliquid.xyz/evm
GRAVITY_RPC=https://rpc.gravity.xyz

# Non-EVM Wallets
SOL_PRIVATE_KEY=your_solana_private_key_base58_here
SOL_WALLET_ADDRESS=your_solana_public_address_here
SOL_RPC=https://solana-rpc.publicnode.com

TRX_PRIVATE_KEY=your_tron_private_key_here
TRX_WALLET_ADDRESS=your_tron_public_address_here
TRX_RPC=https://api.trongrid.io
TRONGRID_API_KEY=

TON_PRIVATE_KEY=your_ton_wallet_mnemonic_24_words_here
TON_WALLET_ADDRESS=your_ton_public_address_here
TON_RPC=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=
TON_INDEXER_URL=https://toncenter.com/api/v3

SUI_PRIVATE_KEY=your_sui_private_key_here
SUI_WALLET_ADDRESS=your_sui_public_address_here
SUI_RPC=https://sui-rpc.publicnode.com

APTOS_PRIVATE_KEY=your_aptos_private_key_here
APTOS_WALLET_ADDRESS=your_aptos_public_address_here
APTOS_RPC=https://fullnode.mainnet.aptoslabs.com/v1
APTOS_INDEXER_URL=https://api.mainnet.aptoslabs.com/v1/graphql

# General Configurations
ORDER_EXPIRE_MINUTES=30
DEFAULT_SPREAD_PCT=1.5
EVM_DEPOSIT_CONFIRMATIONS=2
# CoinGecko Demo key (optional but recommended to avoid public rate limits).
COINGECKO_API_KEY=
